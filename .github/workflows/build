
name: DNSphere Portable Build

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build DNSphere Portable
    runs-on: windows-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Setup .NET 8
        uses: actions/setup-dotnet@v6
        with:
          dotnet-version: '8.0.x'

      - name: Restore
        run: dotnet restore DNSphere.csproj

      - name: Publish Portable
        run: >
          dotnet publish DNSphere.csproj
          -c Release
          -r win-x64
          --self-contained true
          -p:PublishSingleFile=false
          -p:DebugType=None
          -p:DebugSymbols=false
          -o ./publish

      - name: Create ZIP
        shell: pwsh
        run: |
          Compress-Archive `
            -Path "./publish/*" `
            -DestinationPath "./DNSphere-Portable-win-x64.zip" `
            -CompressionLevel Optimal `
            -Force

      - name: Upload ZIP
        uses: actions/upload-artifact@v7
        with:
          name: DNSphere-Portable-win-x64
          path: DNSphere-Portable-win-x64.zip
          retention-days: 30
