
name: DNSphere Portable Build

on:
  push:
    branches:
      - main

  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build DNSphere
    runs-on: windows-latest

    steps:

      # 1. Checkout source code
      - name: Checkout Repository
        uses: actions/checkout@v4

      # 2. Setup .NET 8 SDK
      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '8.0.x'

      # 3. Restore NuGet dependencies
      - name: Restore Dependencies
        run: dotnet restore DnsChanger.csproj

      # 4. Publish Portable Application
      - name: Publish DNSphere
        run: >
          dotnet publish DnsChanger.csproj
          --configuration Release
          --runtime win-x64
          --self-contained true
          -p:AssemblyName=DNSphere
          -p:PublishSingleFile=false
          -p:PublishTrimmed=false
          -p:DebugType=None
          -p:DebugSymbols=false
          --output ./publish

      # 5. Verify Build Output
      - name: Verify Output
        shell: pwsh
        run: |
          if (!(Test-Path "./publish/DNSphere.exe")) {
              throw "DNSphere.exe was not generated!"
          }

          Write-Host "DNSphere build completed successfully."

          Get-ChildItem "./publish" -File |
              Select-Object Name, Length |
              Format-Table -AutoSize

      # 6. Create Portable ZIP
      - name: Create Portable ZIP
        shell: pwsh
        run: |
          Compress-Archive `
            -Path "./publish/*" `
            -DestinationPath "./DNSphere-Portable-win-x64.zip" `
            -CompressionLevel Optimal `
            -Force

      # 7. Upload Build Artifact
      - name: Upload Artifact
        uses: actions/upload-artifact@v4
        with:
          name: DNSphere-Portable-win-x64
          path: DNSphere-Portable-win-x64.zip
          retention-days: 30
          if-no-files-found: error
